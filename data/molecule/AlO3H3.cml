  <propertyList title="property">
    <property title="Weight">78.0</property>
    <property title="Name">Aluminium hydroxide</property>
    <property title="Description">Aluminium hydroxide, Al(OH)3, is found in nature as the mineral gibbsite and its three much rarer polymorphs: bayerite, doyleite, and nordstrandite. Aluminium hydroxide is amphoteric, meaning it has both basic and acidic properties. Closely related are aluminium oxide hydroxide, AlO(OH), and aluminium oxide, Al2O3, which differ only by loss of water. These compounds together are the major components of the aluminium ore bauxite.</property>
    <property title="Smiles">[Al+3]([OH-])([OH-])([OH-])</property>
    <property title="DescriptionAttribution">Simon Norberg</property>
