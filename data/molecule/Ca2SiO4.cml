<?xml version="1.0"?>
<ns0:molecule xmlns:ns0="http://www.xml-cml.org/schema">
  <ns0:atomArray>
    <atom x2="0.5" y2="-0.633975" formalCharge="2" id="a1" elementType="Ca"/>
    <atom x2="1.0" y2="-1.5" formalCharge="-1" id="a2" elementType="O"/>
    <atom x2="2.0" y2="-1.5" id="a3" elementType="Si"/>
    <atom x2="2.0" y2="-2.5" formalCharge="-1" id="a4" elementType="O"/>
    <atom x2="3.0" y2="-1.5" formalCharge="-1" id="a5" elementType="O"/>
    <atom x2="2.0" y2="-0.5" formalCharge="-1" id="a6" elementType="O"/>
    <atom x2="3.5" y2="-0.633975" formalCharge="2" id="a7" elementType="Ca"/>
  </ns0:atomArray>
  <ns0:bondArray>
    <bond atomRefs2="a1 a2" order="0"/>
    <bond atomRefs2="a2 a3" order="1"/>
    <bond atomRefs2="a3 a4" order="1"/>
    <bond atomRefs2="a3 a5" order="1"/>
    <bond atomRefs2="a3 a6" order="1"/>
