<?xml version="1.0"?>
<ns0:molecule xmlns:ns0="http://www.xml-cml.org/schema">
  <ns0:atomArray>
    <atom x2="2.0" y2="0.0" formalCharge="2" id="a1" elementType="Ca"/>
    <atom x2="1.5" y2="0.866025" formalCharge="-2" id="a2" elementType="O"/>
    <atom x2="0.5" y2="0.866025" formalCharge="2" id="a3" elementType="Mg"/>
    <atom x2="-0.0" y2="-0.0" formalCharge="-2" id="a4" elementType="O"/>
  </ns0:atomArray>
  <ns0:bondArray>
    <bond atomRefs2="a1 a2" order="1"/>
    <bond atomRefs2="a2 a3" order="1"/>
    <bond atomRefs2="a3 a4" order="1"/>
  </ns0:bondArray>
  <propertyList title="states">
    <propertyList title="Solid">
      <property title="enthalpy">
        <scalar units="units:molar_energy">-1236.0</scalar>
      </property>
      <property title="entropy">
        <scalar units="units:molar_energy">66.7</scalar>
      </property>
    </propertyList>
  </propertyList>
  <propertyList title="property">
    <property title="Name">Dolime</property>
    <property title="Description">Dolime, or calcined dolomite, is a highly reactive mixture of calcium oxide and magnesium oxide produced by heating dolomite.</property>
    <property title="DescriptionAttribution">https://en.wikipedia.org/wiki/Dolime</property>
    <property title="DescriptionLicense">CC BY-SA 3.0</property>
    <property title="Smiles">[Ca+2][O-2][Mg+2][O-2]</property>
  </propertyList>
</ns0:molecule>
