<ns0:molecule xmlns:ns0="http://www.xml-cml.org/schema">
  <ns0:atomArray>
    <atom x2="1.0" y2="0.0" id="a1" elementType="Cu"/>
  </ns0:atomArray>
  <propertyList title="states">
    <propertyList title="Solid" emitter="fireworks">
      <property title="enthalpy">
        <scalar units="units:molar_energy">0.0</scalar>
      </property>
      <property title="entropy">
        <scalar units="units:molar_energy">33.0</scalar>
      </property>
    </propertyList>
    <propertyList title="Gas">
      <property title="enthalpy">
        <scalar units="units:molar_energy">338.0</scalar>
      </property>
      <property title="entropy">
        <scalar units="units:molar_energy">166.0</scalar>
