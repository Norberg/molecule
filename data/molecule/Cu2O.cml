<?xml version="1.0"?>
<ns0:molecule xmlns:ns0="http://www.xml-cml.org/schema">
  <ns0:atomArray>
    <atom x2="1.732051" y2="-0.0" formalCharge="1" id="a1" elementType="Cu"/>
    <atom x2="0.866025" y2="0.5" formalCharge="-2" id="a2" elementType="O"/>
    <atom x2="-0.0" y2="-0.0" formalCharge="1" id="a3" elementType="Cu"/>
  </ns0:atomArray>
  <ns0:bondArray>
    <bond atomRefs2="a1 a2" order="1"/>
    <bond atomRefs2="a2 a3" order="1"/>
  </ns0:bondArray>
  <propertyList title="states">
    <propertyList title="Solid">
      <property title="enthalpy">
        <scalar units="units:molar_energy">-26.7</scalar>
      </property>
      <property title="entropy">
        <scalar units="units:molar_energy">150.0</scalar>
      </property>
    </propertyList>
  </propertyList>
  <propertyList title="property">
    <property title="Name">Copper(I) oxide</property>
    <property title="Description">Copper(I) oxide or cuprous oxide is the inorganic compound with the formula Cu2O. It is one of the principal oxides of copper, the other being or copper(II) oxide (CuO). This red-coloured solid is a component of some antifouling paints. The compound can appear either yellow or red, depending on the size of the particles. Copper(I) oxide is found as the reddish mineral cuprite.</property>
    <property title="DescriptionAttribution">https://en.wikipedia.org/wiki/Copper(I)_oxide</property>
    <property title="DescriptionLicense">CC BY-SA 3.0</property>
    <property title="Smiles">[Cu+][O-2][Cu+]</property>
  </propertyList>
</ns0:molecule>
