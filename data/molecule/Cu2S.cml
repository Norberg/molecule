<?xml version="1.0"?>
<ns0:molecule xmlns:ns0="http://www.xml-cml.org/schema">
  <ns0:atomArray>
    <atom x2="1.732051" y2="-0.0" formalCharge="1" id="a1" elementType="Cu"/>
    <atom x2="0.866025" y2="0.5" formalCharge="-2" id="a2" elementType="S"/>
    <atom x2="-0.0" y2="-0.0" formalCharge="1" id="a3" elementType="Cu"/>
  </ns0:atomArray>
  <ns0:bondArray>
    <bond atomRefs2="a1 a2" order="1"/>
    <bond atomRefs2="a2 a3" order="1"/>
  </ns0:bondArray>
  <propertyList title="states">
    <propertyList title="Solid">
      <property title="enthalpy">
        <scalar units="units:molar_energy">-343.7</scalar>
      </property>
      <property title="entropy">
        <scalar units="units:molar_energy">60.0</scalar>
      </property>
    </propertyList>
  </propertyList>
  <propertyList title="property">
    <property title="Name">Copper(I) sulfide</property>
    <property title="Description">Copper(I) sulfide is a copper sulfide, a chemical compound of copper and sulfur. It has the chemical compound Cu2S. It is found in nature as the mineral chalcocite. It has a narrow stoichiometry range ranging from Cu1.997S to Cu2.000S.</property>
    <property title="DescriptionAttribution">https://en.wikipedia.org/wiki/Copper(I)_sulfide</property>
    <property title="DescriptionLicense">CC BY-SA 3.0</property>
    <property title="Smiles">[Cu+][S-2][Cu+]</property>
  </propertyList>
</ns0:molecule>
