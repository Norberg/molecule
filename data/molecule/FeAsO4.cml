<?xml version="1.0"?>
<ns0:molecule xmlns:ns0="http://www.xml-cml.org/schema" spinMultiplicity="2">
  <ns0:atomArray>
    <atom x2="3.5" y2="-0.5" formalCharge="3" id="a1" elementType="Fe"/>
    <atom x2="1.5" y2="-2.5" formalCharge="-1" id="a2" elementType="O"/>
    <atom x2="1.5" y2="-1.5" id="a3" elementType="As"/>
    <atom x2="2.5" y2="-1.5" id="a4" elementType="O"/>
    <atom x2="1.5" y2="-0.5" formalCharge="-1" id="a5" elementType="O"/>
    <atom x2="0.5" y2="-1.5" formalCharge="-1" id="a6" elementType="O"/>
  </ns0:atomArray>
  <ns0:bondArray>
    <bond atomRefs2="a2 a3" order="1"/>
    <bond atomRefs2="a3 a4" order="2"/>
    <bond atomRefs2="a3 a5" order="1"/>
    <bond atomRefs2="a3 a6" order="1"/>
    <bond atomRefs2="a1 a2" order="0"/>
    <bond atomRefs2="a1 a5" order="0"/>
    <bond atomRefs2="a1 a6" order="0"/>
  </ns0:bondArray>
  <propertyList title="states">
    <propertyList title="Solid">
      <property title="enthalpy">
        <scalar units="units:molar_energy">-1400.0</scalar>
      </property>
      <property title="entropy">
        <scalar units="units:molar_energy">150.0</scalar>
      </property>
    </propertyList>
  </propertyList>
  <propertyList title="property">
    <property title="Smiles">[Fe+3].[O-][As](=O)([O-])[O-]</property>
    <property title="Name">Ferric arsenate</property>
    <property title="Description">Ferric arsenate, commonly found in nature as the mineral scorodite, is a stable crystalline compound used to immobilize arsenic in industrial waste.
The formation of FeAsO4 is highly pH-dependent, with maximum precipitation efficiency typically occurring under acidic to neutral conditions.
Due to its low solubility, it serves as a critical end-product in environmental remediation to prevent arsenic from leaching back into groundwater.
</property>
    <property title="DescriptionAttribution">Simon Norberg</property>
    <property title="DescriptionLicense">GPLv3</property>
  </propertyList>
</ns0:molecule>
