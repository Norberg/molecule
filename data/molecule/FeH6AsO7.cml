  <propertyList title="property">
    <property title="Name">Iron hydroxide-Arsenic complex</property>
    <property title="Description">An adsorption complex where arsenic acid molecule is bound to the surface of ferric hydroxide (ferrihydrite). This is a primary mechanism for arsenic removal in water treatment using iron-based coagulants.</property>
