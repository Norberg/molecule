<?xml version="1.0"?>
<ns0:molecule xmlns:ns0="http://www.xml-cml.org/schema">
  <ns0:atomArray>
    <atom x2="0.0" y2="0.0" id="a1" elementType="Fe"/>
    <atom x2="2.0" y2="0.0" id="a2" elementType="Si"/>
  </ns0:atomArray>
  <ns0:bondArray>
    <bond atomRefs2="a1 a2" order="1"/>
  </ns0:bondArray>
  <propertyList title="states">
    <propertyList title="Solid">
      <property title="enthalpy">
        <scalar units="units:molar_energy">-30.0</scalar>
      </property>
      <property title="entropy">
        <scalar units="units:molar_energy">30.0</scalar>
      </property>
    </propertyList>
  </propertyList>
  <propertyList title="property">
    <property title="Name">Ferrosilicon</property>
    <property title="Description">Ferrosilicon is an alloy of iron and silicon with a typical silicon content by weight of 15-90%. It is used as a source of silicon to reduce metals from their oxides and to deoxidize steel and other ferrous alloys. In the Pidgeon process, ferrosilicon is used to reduce magnesium from dolomite or magnesite ores.</property>
    <property title="DescriptionAttribution">https://en.wikipedia.org/wiki/Ferrosilicon</property>
    <property title="DescriptionLicense">CC BY-SA 3.0</property>
    <property title="Smiles">[Fe][Si]</property>
  </propertyList>
</ns0:molecule>
