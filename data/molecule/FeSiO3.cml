<?xml version="1.0"?>
<ns0:molecule xmlns:ns0="http://www.xml-cml.org/schema">
  <ns0:atomArray>
    <atom x2="-0.5" y2="-0.0" formalCharge="2" id="a1" elementType="Fe"/>
    <atom x2="0.5" y2="0.0" formalCharge="-1" id="a2" elementType="O"/>
    <atom x2="1.5" y2="0.0" id="a3" elementType="Si"/>
    <atom x2="1.5" y2="-1.0" formalCharge="-1" id="a4" elementType="O"/>
    <atom x2="2.5" y2="0.0" formalCharge="-1" id="a5" elementType="O"/>
  </ns0:atomArray>
  <ns0:bondArray>
    <bond atomRefs2="a1 a2" order="0"/>
    <bond atomRefs2="a2 a3" order="1"/>
    <bond atomRefs2="a3 a4" order="1"/>
    <bond atomRefs2="a3 a5" order="1"/>
    <bond atomRefs2="a1 a4" order="0"/>
  </ns0:bondArray>
  <propertyList title="states">
    <propertyList title="Solid">
      <property title="enthalpy">
        <scalar units="units:molar_energy">-1133.0</scalar>
      </property>
      <property title="entropy">
        <scalar units="units:molar_energy">150.0</scalar>
      </property>
    </propertyList>
  </propertyList>
  <propertyList title="property">
    <property title="Name">Iron(II) silicate</property>
    <property title="Description">Iron(II) silicate, also called ferrous silicate, is the chemical compound Fe2SiO4. It is the iron analogue of the mineral olivine, and is known as fayalite in mineralogy. It occurs in nature as a minor constituent of many volcanic rocks, and in meteorites.</property>
    <property title="DescriptionAttribution">https://en.wikipedia.org/wiki/Iron(II)_silicate</property>
    <property title="DescriptionLicense">CC BY-SA 3.0</property>
    <property title="Smiles">[Fe+2].[O-][Si]([O-])[O-]</property>
  </propertyList>
</ns0:molecule>
