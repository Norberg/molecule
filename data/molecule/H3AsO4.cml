    <atom x2="0.159955" y2="-1.485" id="a6" elementType="H"/>
    <atom x2="2.485" y2="-0.840045" id="a7" elementType="H"/>
    <atom x2="-0.485" y2="0.840045" id="a8" elementType="H"/>
  </ns0:atomArray>
  <ns0:bondArray>
    <bond atomRefs2="a1 a2" order="1"/>
    <bond atomRefs2="a2 a3" order="1"/>
    <bond atomRefs2="a2 a4" order="1"/>
    <bond atomRefs2="a2 a5" order="1"/>
