  <propertyList title="property">
    <property title="Radius">1.55</property>
    <property title="Name">Mercury</property>
    <property title="Weight">200.59</property>
    <property title="Description">Mercury is a chemical element; it has symbol Hg (from the Greek word hydrargyrum 'liquid silver') and atomic number 80. It is a heavy, silvery d-block element, and is the only metallic element that is liquid at standard conditions for temperature and pressure. The main mercury ore is cinnabar (mercuric sulfide).
Mercury is used in thermometers, barometers, manometers, sphygmomanometers, float valves, mercury switches, mercury relays, fluorescent lamps and other devices, though concerns about the element's toxicity have led to mercury thermometers and sphygmomanometers being largely phased out in clinical environments in favour of alternatives.</property>
    <property title="DescriptionAttribution">Simon Norberg</property>
    <property title="DescriptionLicense">GPLv3</property>
    <property title="Smiles">[Hg]</property>
  </propertyList>
</ns0:molecule>
