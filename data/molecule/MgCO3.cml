<?xml version="1.0"?>
<ns0:molecule xmlns:ns0="http://www.xml-cml.org/schema">
  <ns0:atomArray>
    <atom x2="1.0" y2="-0.0" id="a1" elementType="C"/>
    <atom x2="1.707107" y2="-0.707107" id="a2" elementType="O"/>
    <atom x2="0.0" y2="-0.0" formalCharge="-1" id="a3" elementType="O"/>
    <atom x2="-0.0" y2="1.0" formalCharge="2" id="a4" elementType="Mg"/>
    <atom x2="1.0" y2="1.0" formalCharge="-1" id="a5" elementType="O"/>
  </ns0:atomArray>
  <ns0:bondArray>
    <bond atomRefs2="a1 a2" order="2"/>
    <bond atomRefs2="a1 a3" order="1"/>
    <bond atomRefs2="a3 a4" order="1"/>
    <bond atomRefs2="a4 a5" order="1"/>
    <bond atomRefs2="a1 a5" order="1"/>
  </ns0:bondArray>
  <propertyList title="states">
    <propertyList title="Solid">
      <property title="enthalpy">
        <scalar units="units:molar_energy">-1095.8</scalar>
      </property>
      <property title="entropy">
        <scalar units="units:molar_energy">65.1</scalar>
      </property>
    </propertyList>
  </propertyList>
  <propertyList title="property">
    <property title="Name">Magnesite</property>
    <property title="Description">Magnesite is a mineral with the chemical formula MgCO3 (magnesium carbonate). Mixed crystals of iron(II) carbonate and magnesite exist. Magnesite can be formed by talc carbonate metasomatism of peridotite and other ultramafic rocks. Magnesite is an important ore for magnesium.</property>
    <property title="DescriptionAttribution">https://en.wikipedia.org/wiki/Magnesite</property>
    <property title="DescriptionLicense">CC BY-SA 3.0</property>
    <property title="Smiles">C1(=O)[O-][Mg+2][O-]1</property>
  </propertyList>
</ns0:molecule>
