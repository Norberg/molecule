<?xml version="1.0"?>
<ns0:molecule xmlns:ns0="http://www.xml-cml.org/schema">
  <ns0:atomArray>
    <atom x2="0.0" y2="0.0" id="a1" elementType="Al"/>
    <atom x2="1.0" y2="0.0" id="a2" elementType="F"/>
    <atom x2="-1.0" y2="0.0" id="a3" elementType="F"/>
    <atom x2="0.0" y2="1.0" id="a4" elementType="F"/>
    <atom x2="0.0" y2="-1.0" id="a5" elementType="F"/>
    <atom x2="0.7" y2="0.7" id="a6" elementType="F"/>
    <atom x2="-0.7" y2="-0.7" id="a7" elementType="F"/>
    <atom x2="2.0" y2="0.0" id="a8" elementType="Na"/>
    <atom x2="-2.0" y2="0.0" id="a9" elementType="Na"/>
    <atom x2="0.0" y2="2.0" id="a10" elementType="Na"/>
  </ns0:atomArray>
  <ns0:bondArray>
    <bond atomRefs2="a1 a2" order="1"/>
    <bond atomRefs2="a1 a3" order="1"/>
    <bond atomRefs2="a1 a4" order="1"/>
    <bond atomRefs2="a1 a5" order="1"/>
    <bond atomRefs2="a1 a6" order="1"/>
    <bond atomRefs2="a1 a7" order="1"/>
  </ns0:bondArray>
  <propertyList title="states">
    <propertyList title="Solid">
      <property title="enthalpy">
        <scalar units="units:molar_energy">-3300.0</scalar>
      </property>
      <property title="entropy">
        <scalar units="units:molar_energy">238.0</scalar>
      </property>
    </propertyList>
  </propertyList>
  <propertyList title="property">
    <property title="Weight">210.0</property>
    <property title="Name">Cryolite</property>
    <property title="Description">Cryolite (Na3AlF6, sodium hexafluoroaluminate) is an uncommon mineral of very limited natural distribution. Historically it was used as an ore of aluminium and later in the electrolytic processing of the aluminium-rich oxide ore bauxite (itself a combination of aluminium oxide minerals such as gibbsite, boehmite and diaspore). The difficulty of separating aluminium from oxygen in the oxide ores was overcome by the use of cryolite as a flux to dissolve the oxide mineral(s).</property>
  </propertyList>
