<?xml version="1.0"?>
<ns0:molecule xmlns:ns0="http://www.xml-cml.org/schema">
  <ns0:atomArray>
    <atom x2="1.732051" y2="-0.0" id="a1" elementType="Cl"/>
    <atom x2="0.866025" y2="0.5" id="a2" elementType="Pb"/>
    <atom x2="-0.0" y2="-0.0" id="a3" elementType="Cl"/>
  </ns0:atomArray>
  <ns0:bondArray>
    <bond atomRefs2="a1 a2" order="1"/>
    <bond atomRefs2="a2 a3" order="1"/>
  </ns0:bondArray>
  <propertyList title="states">
    <propertyList title="Solid">
      <property title="enthalpy">
        <scalar units="units:molar_energy">-359.4</scalar>
      </property>
      <property title="entropy">
        <scalar units="units:molar_energy">136.0</scalar>
      </property>
    </propertyList>
    <propertyList title="Aqueous">
      <property title="ions">
        <reaction>
          <productList>
            <molecule title="Pb+2(aq)"/>
            <molecule title="Cl-(aq)"/>
            <molecule title="Cl-(aq)"/>
          </productList>
        </reaction>
      </property>
    </propertyList>
  </propertyList>
  <propertyList title="property">
    <property title="Name">Lead(II) chloride</property>
    <property title="Description">Lead(II) chloride (PbCl2) is an inorganic compound which is a white solid under ambient conditions. It is poorly soluble in water. Lead(II) chloride is one of the most important lead-based reagents. It also occurs naturally in the form of the mineral cotunnite.</property>
    <property title="DescriptionAttribution">https://en.wikipedia.org/wiki/Lead(II)_chloride</property>
    <property title="DescriptionLicense">CC BY-SA 3.0</property>
    <property title="Smiles">Cl[Pb]Cl</property>
  </propertyList>
</ns0:molecule>
