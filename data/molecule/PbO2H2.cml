  <propertyList title="property">
    <property title="Name">Lead(II) hydroxide</property>
    <property title="Weight">241.2</property>
    <property title="Radius">1.9</property>
    <property title="Smiles">[OH-][Pb+2][OH-]</property>
    <property title="DescriptionAttribution">https://en.wikipedia.org/wiki/Lead(II)_hydroxide</property>
    <property title="DescriptionLicense">CC BY-SA 3.0</property>
    <property title="Description">Lead(II) hydroxide (Pb(OH)&#x2082;) is an extremely insoluble white solid (Ksp &#x2248; 1.2&#xD7;10&#x207B;&#xB9;&#x2075;). It forms when aqueous lead(II) ions meet hydroxide ions under alkaline conditions. Lead hydroxide precipitation is the classical method for removing lead from contaminated wastewater and acid mine drainage: by adding lime (Ca(OH)&#x2082;) to raise the pH above 8, lead ions are driven out of solution as the insoluble hydroxide and can then be filtered off. This technique is widely used at former mining and smelting sites to protect rivers and groundwater.</property>
  </propertyList>
</ns0:molecule>
