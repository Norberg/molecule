<?xml version="1.0"?>
<reactions>
  <!-- Basic inorganic & elemental reactions (subset) -->
  <reaction>
    <reactantList>
      <molecule title="O"/>
      <molecule title="H+"/>
    </reactantList>
    <productList>
      <molecule title="OH-(aq)"/>
    </productList>
    <tagList>
      <tag>Protonation</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="O"/>
      <molecule title="O"/>
    </reactantList>
    <productList>
      <molecule title="O2(g)"/>
    </productList>
    <tagList>
      <tag>Combination reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="O"/>
      <molecule title="H2"/>
    </reactantList>
    <productList>
      <molecule title="H2O(l)"/>
    </productList>
    <tagList>
      <tag>Combination reaction</tag>
    </tagList>
  </reaction>
  <!-- Bulk water formation using molecular oxygen -->
  <reaction>
    <reactantList>
      <molecule title="H2"/>
      <molecule title="H2"/>
      <molecule title="O2"/>
    </reactantList>
    <productList>
      <molecule title="H2O(l)"/>
      <molecule title="H2O(l)"/>
    </productList>
    <tagList>
      <tag>Combustion reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="H+"/>
      <molecule title="H+"/>
    </reactantList>
    <productList>
      <molecule title="H2(g)"/>
    </productList>
    <tagList>
      <tag>Reduction reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="H+"/>
      <molecule title="OH-"/>
    </reactantList>
    <productList>
      <molecule title="H2O(l)"/>
    </productList>
    <tagList>
      <tag>Neutralization reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="H3O+"/>
      <molecule title="OH-"/>
    </reactantList>
    <productList>
      <molecule title="H2O(l)"/>
      <molecule title="H2O(l)"/>
    </productList>
    <requirementList>
      <requirement type="pH max" value="6.0"/>
    </requirementList>
    <description>
      Hydronium and hydroxide undergo rapid proton transfer to form two water molecules.
      In strongly acidic solution, the high hydronium activity drives this neutralization efficiently to water.
    </description>
    <tagList>
      <tag>Acid-base reaction</tag>
      <tag>Equilibrium</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="HSO4-"/>
      <molecule title="OH-"/>
    </reactantList>
    <productList>
      <molecule title="SO4-2(aq)"/>
      <molecule title="H2O(l)"/>
    </productList>
    <description>
      Hydrogen sulfate donates a proton to hydroxide, yielding sulfate and water.
      This is a Br&#xF8;nsted acid-base deprotonation step driven by water formation.
    </description>
    <tagList>
      <tag>Acid-base reaction</tag>
      <tag>Equilibrium</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="NH3"/>
      <molecule title="H3O+"/>
    </reactantList>
    <productList>
      <molecule title="NH4+(aq)"/>
      <molecule title="H2O(l)"/>
    </productList>
    <requirementList>
      <requirement type="pH max" value="7.0"/>
    </requirementList>
    <description>
      Ammonia is protonated by hydronium to form ammonium and water.
      The NH4+/NH3 conjugate pair has pKa about 9.25, so lower pH shifts composition toward NH4+.
    </description>
    <tagList>
      <tag>Acid-base reaction</tag>
      <tag>Protonation</tag>
      <tag>Equilibrium</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="HCO3-"/>
      <molecule title="H3O+"/>
    </reactantList>
    <productList>
      <molecule title="H2CO3(aq)"/>
      <molecule title="H2O(l)"/>
    </productList>
    <requirementList>
      <requirement type="pH max" value="6.0"/>
    </requirementList>
    <description>
      Hydronium protonates hydrogen carbonate to carbonic acid and water.
      Below the first carbonic-acid pKa, carbonate speciation shifts toward the protonated form.
    </description>
    <tagList>
      <tag>Acid-base reaction</tag>
      <tag>Protonation</tag>
      <tag>Equilibrium</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="HCO3-"/>
      <molecule title="OH-"/>
    </reactantList>
    <productList>
      <molecule title="CO3-2(aq)"/>
      <molecule title="H2O(l)"/>
    </productList>
    <requirementList>
      <requirement type="pH min" value="10.0"/>
    </requirementList>
    <description>
      In strongly basic solution, hydrogen carbonate is further deprotonated to carbonate.
      This corresponds to the second dissociation step of the carbonic-acid system.
    </description>
    <tagList>
      <tag>Acid-base reaction</tag>
      <tag>Equilibrium</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="CH4"/>
      <molecule title="H2O"/>
    </reactantList>
    <productList>
      <molecule title="CO(g)"/>
      <molecule title="H2(g)"/>
      <molecule title="H2(g)"/>
      <molecule title="H2(g)"/>
    </productList>
    <tagList>
      <tag>Redox reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="CH4"/>
      <molecule title="O2"/>
      <molecule title="O2"/>
    </reactantList>
    <productList>
      <molecule title="CO2(g)"/>
      <molecule title="H2O(g)"/>
      <molecule title="H2O(g)"/>
    </productList>
    <tagList>
      <tag>Combustion reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="CaCO3"/>
    </reactantList>
    <productList>
      <molecule title="CaO(s)"/>
      <molecule title="CO2(g)"/>
    </productList>
    <description>
      Heating calcium carbonate (limestone) causes calcination, breaking it into calcium oxide (quicklime) and carbon dioxide gas.
      The strongly endothermic step is foundational in lime production and serves as a CO2 supply in the Solvay cycle.
      Furnace temperature, particle size, and residence time determine conversion efficiency and energy use.
      Released CO2 may be captured for carbonation steps, improving material circularity.
      Reactive CaO produced here also participates in ammonia regeneration routes.
    </description>
    <tagList>
      <tag>Thermal decomposition</tag>
      <tag>Calcination</tag>
      <tag>CO2 source</tag>
      <tag>Endothermic</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="CaO"/>
      <molecule title="H2O"/>
    </reactantList>
    <productList>
      <molecule title="CaO2H2(s)"/>
    </productList>
    <tagList>
      <tag>Combination reaction</tag>
    </tagList>
  </reaction>
  <!-- Added remaining migrated reactions -->
  <!-- Start appended -->
  <!-- Combustion / synthesis -->
  <!-- CH4 partial oxidation -->
  <reaction>
    <reactantList>
      <molecule title="CH4"/>
      <molecule title="O2"/>
    </reactantList>
    <productList>
      <molecule title="CO(g)"/>
      <molecule title="H2O(g)"/>
      <molecule title="H2(g)"/>
    </productList>
    <tagList>
      <tag>Redox reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="CaMgC2O6"/>
    </reactantList>
    <productList>
      <molecule title="CaMgO2(s)"/>
      <molecule title="CO2(g)"/>
      <molecule title="CO2(g)"/>
    </productList>
    <description>
      Calcination of Dolomite (CaMg(CO3)2). Heating dolomite causes it to decompose into calcined dolomite or dolime (a mixture of calcium oxide and magnesium oxide) and carbon dioxide gas. This highly endothermic step is the first in the Pidgeon process.
    </description>
    <tagList>
      <tag>Thermal decomposition</tag>
      <tag>Calcination</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="CaMgO2"/>
      <molecule title="CaMgO2"/>
      <molecule title="FeSi"/>
    </reactantList>
    <productList>
      <molecule title="Ca2SiO4(s)"/>
      <molecule title="Fe(s)"/>
      <molecule title="Mg(s)"/>
      <molecule title="Mg(s)"/>
    </productList>
    <description>
      The Pidgeon process for the production of metallic magnesium. Calcined dolomite (a mixture of MgO and CaO) is reduced by silicon (typically as a ferrosilicon alloy) at high temperatures. The reaction produces magnesium vapor, solid calcium silicate slag, and iron.
    </description>
    <tagList>
      <tag>Reduction reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="NH3"/>
      <molecule title="NH3"/>
      <molecule title="CO2"/>
    </reactantList>
    <productList>
      <molecule title="CH4N2O(s)"/>
      <molecule title="H2O(g)"/>
    </productList>
    <tagList>
      <tag>Condensation reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="N"/>
      <molecule title="N"/>
    </reactantList>
    <productList>
      <molecule title="N2(g)"/>
    </productList>
    <tagList>
      <tag>Combination reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="H2"/>
      <molecule title="H2"/>
      <molecule title="H2"/>
      <molecule title="N2"/>
    </reactantList>
    <productList>
      <molecule title="NH3(g)"/>
      <molecule title="NH3(g)"/>
    </productList>
    <tagList>
      <tag>Reduction reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="C2H6O"/>
      <molecule title="O2"/>
      <molecule title="O2"/>
      <molecule title="O2"/>
    </reactantList>
    <productList>
      <molecule title="CO2(g)"/>
      <molecule title="CO2(g)"/>
      <molecule title="H2O(g)"/>
      <molecule title="H2O(g)"/>
      <molecule title="H2O(g)"/>
    </productList>
    <tagList>
      <tag>Combustion reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="Ca+2"/>
      <molecule title="CO3-2"/>
    </reactantList>
    <productList>
      <molecule title="CaCO3(s)"/>
    </productList>
    <tagList>
      <tag>Precipitation</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="HOCl"/>
      <molecule title="C2H4"/>
    </reactantList>
    <productList>
      <molecule title="C2H5ClO(l)"/>
    </productList>
    <tagList>
      <tag>Addition reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="C"/>
      <molecule title="O2"/>
    </reactantList>
    <productList>
      <molecule title="CO2(g)"/>
    </productList>
    <tagList>
      <tag>Combustion reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="C"/>
      <molecule title="CO2"/>
    </reactantList>
    <productList>
      <molecule title="CO(g)"/>
      <molecule title="CO(g)"/>
    </productList>
    <tagList>
      <tag>Redox reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="CO"/>
      <molecule title="CO"/>
    </reactantList>
    <productList>
      <molecule title="C(s)"/>
      <molecule title="CO2(g)"/>
    </productList>
    <tagList>
      <tag>Disproportionation reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="P4"/>
      <molecule title="O2"/>
      <molecule title="O2"/>
      <molecule title="O2"/>
      <molecule title="O2"/>
      <molecule title="O2"/>
    </reactantList>
    <productList>
      <molecule title="P4O10(s)"/>
    </productList>
    <tagList>
      <tag>Combustion reaction</tag>
    </tagList>
  </reaction>
  <!-- Carbocation / addition / substitution cluster -->
  <reaction>
    <reactantList>
      <molecule title="C2H4"/>
      <molecule title="H+"/>
    </reactantList>
    <productList>
      <molecule title="C2H5+(aq)"/>
    </productList>
    <description>
      Ethene (C2H4), acting as a nucleophile due to its electron-rich &#x3C0;-bond, attacks the
      electrophilic hydrogen ion (H&#x207A;).
      This electrophilic addition step breaks the double bond and results in the formation of a
      carbocation intermediate (C2H5&#x207A;) on the more substituted carbon, following Markovnikov's rule.
      In this step, ethene is the nucleophile and H&#x207A; is the electrophile.
    </description>
    <tagList>
      <tag>Electrophilic addition</tag>
      <tag>Carbocation formation</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="C2H5+"/>
      <molecule title="Br-"/>
    </reactantList>
    <productList>
      <molecule title="C2H5Br(g)"/>
    </productList>
    <description>
      In this final step, the bromide ion (Br&#x207B;), which acts as a nucleophile, attacks the positively
      charged carbocation (C2H5&#x207A;), which serves as the electrophile.
      This nucleophilic substitution results in the formation of the final product, bromoethane
      (C2H5Br).
    </description>
    <tagList>
      <tag>Nucleophilic attack</tag>
      <tag>Alkyl halide reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="C2H4"/>
      <molecule title="HCl"/>
    </reactantList>
    <productList>
      <molecule title="C2H5Cl(g)"/>
    </productList>
    <description>
      Ethene (C2H4) reacts with hydrogen chloride (HCl) to form chloroethane (C2H5Cl) through an
      electrophilic addition mechanism.
      Ethene acts as a nucleophile and attacks the electrophilic hydrogen atom in HCl.
      The double bond in ethene is broken and replaced by a single bond with added hydrogen and
      chlorine atoms.
      The reaction proceeds via a carbocation intermediate and typically follows Markovnikov&#x2019;s rule.
      This process is fundamental in the production of alkyl halides.
    </description>
    <tagList>
      <tag>Addition reaction</tag>
      <tag>Electrophilic addition</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="C2H4"/>
      <molecule title="HBr"/>
    </reactantList>
    <productList>
      <molecule title="C2H5Br(g)"/>
    </productList>
    <description>
      Ethene reacts with hydrogen bromide in an electrophilic addition to form bromoethane.
    </description>
    <tagList>
      <tag>Addition reaction</tag>
      <tag>Electrophilic addition</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="OH-"/>
      <molecule title="CH3Br"/>
    </reactantList>
    <productList>
      <molecule title="CH3OH(l)"/>
      <molecule title="Br-(aq)"/>
    </productList>
    <description>
      Hydroxide ion (OH-) reacts with methyl bromide (CH3Br) to form methanol (CH3OH) and bromide
      ion (Br-).
      This is an example of a nucleophilic substitution reaction where the hydroxide ion acts as a
      nucleophile, attacking the electrophilic carbon in the methyl bromide.
      The reaction is typically carried out in a polar solvent like water.
      Nucleophilic substitution reactions are common in organic chemistry for replacing functional
      groups.
    </description>
    <tagList>
      <tag>Nucleophilic substitution</tag>
      <tag>SN2 reaction</tag>
      <tag>Alkyl halide reaction</tag>
    </tagList>
  </reaction>
  <!-- Acid/base / carbonate system -->
  <!-- Solvay-related reactions removed (now in solvay_process.cml) -->
  <!-- Tert-butanol formation sequence -->
  <reaction>
    <reactantList>
      <molecule title="C4H9+"/>
      <molecule title="H2O"/>
    </reactantList>
    <productList>
      <molecule title="C4H11O+(l)"/>
    </productList>
    <tagList>
      <tag>Nucleophilic addition</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="C4H11O+"/>
      <molecule title="H2O"/>
    </reactantList>
    <productList>
      <molecule title="C4H10O(l)"/>
      <molecule title="H3O+(aq)"/>
    </productList>
    <tagList>
      <tag>Acid-base reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="H3O+"/>
      <molecule title="Br-"/>
    </reactantList>
    <productList>
      <molecule title="HBr(g)"/>
      <molecule title="H2O(l)"/>
    </productList>
    <tagList>
      <tag>Acid-base reaction</tag>
    </tagList>
  </reaction>
  <!-- End appended -->
  <!-- Golden rain net ionic: Pb+2 + 2 I- -> PbI2(s) -->
  <reaction>
    <reactantList>
      <molecule title="Pb+2"/>
      <molecule title="I-"/>
      <molecule title="I-"/>
    </reactantList>
    <productList>
      <molecule title="PbI2(s)"/>
    </productList>
    <description>
      Net ionic precipitation of lead(II) iodide. When aqueous Pb2+ meets iodide ions the very low solubility product (Ksp) of PbI2 drives immediate formation of bright yellow plate-like crystals ("Golden rain"). Heating can dissolve the precipitate; on cooling it recrystallizes, illustrating temperature&#x2011;dependent solubility and dynamic equilibrium. Spectator ions (K+, NO3-) are omitted from this net ionic form.
    </description>
    <tagList>
      <tag>Precipitation</tag>
      <tag>Net ionic</tag>
      <tag>Golden rain</tag>
    </tagList>
  </reaction>
  <!-- Copper Smelting sequence -->
  <reaction>
    <reactantList>
      <molecule title="CuFeS2"/>
      <molecule title="CuFeS2"/>
      <molecule title="O2"/>
      <molecule title="O2"/>
      <molecule title="O2"/>
      <molecule title="O2"/>
    </reactantList>
    <productList>
      <molecule title="Cu2S(s)"/>
      <molecule title="FeO(s)"/>
      <molecule title="FeO(s)"/>
      <molecule title="SO2(g)"/>
      <molecule title="SO2(g)"/>
      <molecule title="SO2(g)"/>
    </productList>
    <description>
      The first step in copper smelting is the roasting of chalcopyrite (CuFeS2). Here, the copper iron sulfide ore is heated strongly in air. The oxidation leads to the formation of a copper-rich matte consisting primarily of copper(I) sulfide (chalcocite, Cu2S), alongside iron(II) oxide and sulfur dioxide gas.
    </description>
    <tagList>
      <tag>Roasting</tag>
      <tag>Oxidation reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="FeO"/>
      <molecule title="SiO2"/>
    </reactantList>
    <productList>
      <molecule title="FeSiO3(s)"/>
    </productList>
    <description>
      In the smelting process, a flux such as silica (SiO2) is added to react with the iron(II) oxide generated during roasting. This forms a molten iron(II) silicate slag (fayalite, FeSiO3). The lighter slag floats on top of the heavier copper matte, allowing it to be skimmed off and removing iron impurities from the target copper.
    </description>
    <tagList>
      <tag>Slag formation</tag>
      <tag>Combination reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="Cu2S"/>
      <molecule title="Cu2S"/>
      <molecule title="O2"/>
      <molecule title="O2"/>
      <molecule title="O2"/>
    </reactantList>
    <productList>
      <molecule title="Cu2O(s)"/>
      <molecule title="Cu2O(s)"/>
      <molecule title="SO2(g)"/>
      <molecule title="SO2(g)"/>
    </productList>
    <description>
      During the first (slag-forming) stage of the Bessemer converting process for copper, air is blown through the molten matte. A portion of the copper(I) sulfide is oxidized to form copper(I) oxide (cuprite, Cu2O) and sulfur dioxide. 
    </description>
    <tagList>
      <tag>Converting (metallurgy)</tag>
      <tag>Oxidation reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="Cu2O"/>
      <molecule title="Cu2O"/>
      <molecule title="Cu2S"/>
    </reactantList>
    <productList>
      <molecule title="Cu(s)"/>
      <molecule title="Cu(s)"/>
      <molecule title="Cu(s)"/>
      <molecule title="Cu(s)"/>
      <molecule title="Cu(s)"/>
      <molecule title="Cu(s)"/>
      <molecule title="SO2(g)"/>
    </productList>
    <description>
      In the final (blister-forming) stage of copper converting, the supply of air is shut off. The copper(I) oxide produced in the previous step reacts with the remaining copper(I) sulfide in the melt. This self-reduction produces blister copper (nearly pure metallic copper) and releases more sulfur dioxide gas. The process derives its name from the blisters formed as the gas escapes the solidifying metal.
    </description>
    <tagList>
      <tag>Converting (metallurgy)</tag>
      <tag>Redox reaction</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="PbO2H2"/>
    </reactantList>
    <productList>
      <molecule title="Pb+2(aq)"/>
      <molecule title="OH-(aq)"/>
      <molecule title="OH-(aq)"/>
    </productList>
    <tagList>
      <tag>Dissolution</tag>
    </tagList>
  </reaction>
  <!-- Aluminum production sequence -->
  <reaction>
    <reactantList>
      <molecule title="NaCl"/>
      <molecule title="H2O"/>
    </reactantList>
    <productList>
      <molecule title="Na+(aq)"/>
      <molecule title="Cl-(aq)"/>
      <molecule title="OH-(aq)"/>
      <molecule title="H+(aq)"/>
    </productList>
    <requirementList>
      <requirement type="Electrolysis" molar_energy="100.0"/>
    </requirementList>
    <description>
      During electrolysis, solid sodium chloride dissolves and dissociates into aqueous sodium and chloride ions.
    </description>
    <tagList>
      <tag>Electrolysis</tag>
      <tag>Dissolution</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="NaCl"/>
      <molecule title="NaCl"/>
      <molecule title="H2O"/>
      <molecule title="H2O"/>
    </reactantList>
    <productList>
      <molecule title="Na+(aq)"/>
      <molecule title="Na+(aq)"/>
      <molecule title="OH-(aq)"/>
      <molecule title="OH-(aq)"/>
      <molecule title="Cl2(g)"/>
      <molecule title="H2(g)"/>
    </productList>
    <requirementList>
      <requirement type="Electrolysis" molar_energy="600.0"/>
    </requirementList>
    <description>
      The Chloralkali process is an industrial process for the electrolysis of sodium chloride. It is the technology used to produce chlorine and sodium hydroxide (caustic soda), which are commodity chemicals required by industry.
    </description>
    <tagList>
      <tag>Electrolysis</tag>
      <tag>Electrolytic bromine production</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="KBr"/>
      <molecule title="KBr"/>
      <molecule title="H2O"/>
      <molecule title="H2O"/>
    </reactantList>
    <productList>
      <molecule title="K+(aq)"/>
      <molecule title="K+(aq)"/>
      <molecule title="OH-(aq)"/>
      <molecule title="OH-(aq)"/>
      <molecule title="Br2(g)"/>
      <molecule title="H2(g)"/>
    </productList>
    <requirementList>
      <requirement type="Electrolysis" molar_energy="620.0"/>
    </requirementList>
    <description>
      Electrolytic bromine production: concentrated potassium bromide brine is electrolyzed to produce
      bromine at the anode and hydrogen at the cathode, while potassium hydroxide accumulates in
      solution.
    </description>
    <tagList>
      <tag>Electrolysis</tag>
      <tag>Chloralkali process</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="H2"/>
      <molecule title="Br2"/>
    </reactantList>
    <productList>
      <molecule title="HBr(g)"/>
      <molecule title="HBr(g)"/>
    </productList>
    <description>
      Direct synthesis of hydrogen bromide from hydrogen and bromine.
    </description>
    <tagList>
      <tag>Hydrogen halide formation</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="AlO3H3"/>
      <molecule title="Na+"/>
      <molecule title="OH-"/>
    </reactantList>
    <productList>
      <molecule title="NaAlO4H4(aq)"/>
    </productList>
    <description>
      Bayer process - Digestion: Aluminium-bearing minerals in bauxite are selectively dissolved by heating with concentrated sodium hydroxide solution.
    </description>
    <tagList>
      <tag>Bayer process</tag>
      <tag>Dissolution</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="NaAlO4H4"/>
    </reactantList>
    <productList>
      <molecule title="AlO3H3(s)"/>
      <molecule title="Na+(aq)"/>
      <molecule title="OH-(aq)"/>
    </productList>
    <description>
      Bayer process - Precipitation: The clear sodium aluminate solution is cooled and seeded with aluminium hydroxide crystals, causing the dissolved aluminium hydroxide to precipitate. This step also recovers the sodium hydroxide for reuse.
    </description>
    <tagList>
      <tag>Bayer process</tag>
      <tag>Precipitation</tag>
      <tag>Recycling</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="AlO3H3"/>
      <molecule title="AlO3H3"/>
    </reactantList>
    <productList>
      <molecule title="Al2O3(s)"/>
      <molecule title="H2O(g)"/>
      <molecule title="H2O(g)"/>
      <molecule title="H2O(g)"/>
    </productList>
    <description>
      Calcination of aluminium hydroxide: The precipitated aluminium hydroxide is heated to high temperatures (over 1000&#xB0;C) in a kiln. This drives off the chemically combined water, leaving pure aluminium oxide (alumina).
    </description>
    <tagList>
      <tag>Calcination</tag>
      <tag>Thermal decomposition</tag>
    </tagList>
  </reaction>
  <reaction>
    <reactantList>
      <molecule title="Al2O3"/>
      <molecule title="Al2O3"/>
      <molecule title="C"/>
      <molecule title="C"/>
      <molecule title="C"/>
    </reactantList>
    <productList>
      <molecule title="Al(s)"/>
      <molecule title="Al(s)"/>
      <molecule title="Al(s)"/>
      <molecule title="Al(s)"/>
      <molecule title="CO2(g)"/>
      <molecule title="CO2(g)"/>
      <molecule title="CO2(g)"/>
    </productList>
    <requirementList>
      <requirement type="Electrolysis" molar_energy="2200.0"/>
    </requirementList>
    <description>
      Hall-H&#xE9;roult process: The electrolytic reduction of alumina dissolved in molten cryolite. This is the major industrial process for smelting aluminium. The carbon anodes are consumed by reacting with the oxygen from the alumina, producing carbon dioxide.
    </description>
    <tagList>
      <tag>Hall-H&#xE9;roult process</tag>
      <tag>Electrolysis</tag>
      <tag>Reduction</tag>
    </tagList>
  </reaction>
</reactions>
